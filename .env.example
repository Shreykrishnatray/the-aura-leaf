# THE AURA LEAF — local environment
#
# Copy this file to `.env` and fill in your MySQL credentials:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows PowerShell)
#
# Connection string format:
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# The database must exist before running `npm run db:push` or `npm run db:migrate`:
#   CREATE DATABASE aura_leaf CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL="mysql://root:password@localhost:3306/aura_leaf"
